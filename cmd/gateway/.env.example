# Gateway runtime
GATEWAY_HTTP_PORT=:8081
GATEWAY_REDIS_ADDR=127.0.0.1:16379

# Optional unified ingress signature verification
# Leave empty to disable signature validation for POST /v1/channels/incoming
GATEWAY_INGRESS_SECRET=

# Enterprise WeChat self-built app
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_CORP_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_CALLBACK_PATH=/callbacks/wecom
WECOM_API_BASE_URL=https://qyapi.weixin.qq.com
WECOM_MEDIA_DIR=/tmp/agentic-core/wecom-media
# 0 disables cleanup; positive values keep files for N days
WECOM_MEDIA_RETENTION_DAYS=0

# Enterprise WeChat group robot webhook
WECOM_ROBOT_WEBHOOK_URL=

# Feishu self-built app (China site first)
FEISHU_APP_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_VERIFICATION_TOKEN=
FEISHU_APP_ENCRYPT_KEY=
FEISHU_APP_EVENT_CALLBACK_PATH=/callbacks/feishu/events
FEISHU_APP_CARD_CALLBACK_PATH=/callbacks/feishu/cards
# Optional: leave empty to use SDK default open platform endpoint
FEISHU_APP_API_BASE_URL=

# Feishu group bot webhook
FEISHU_BOT_ENABLED=false
FEISHU_BOT_WEBHOOK_URL=
FEISHU_BOT_SECRET=

# DingTalk enterprise app
DINGTALK_APP_ENABLED=false
DINGTALK_APP_CLIENT_ID=
DINGTALK_APP_CLIENT_SECRET=
DINGTALK_APP_AGENT_ID=
DINGTALK_APP_EVENT_CALLBACK_PATH=/callbacks/dingtalk/events
DINGTALK_APP_CARD_CALLBACK_PATH=/callbacks/dingtalk/cards
# Optional: leave empty to use SDK default endpoints
DINGTALK_APP_API_BASE_URL=
DINGTALK_APP_OAPI_BASE_URL=
DINGTALK_APP_TOKEN=
DINGTALK_APP_AES_KEY=
DINGTALK_APP_MEDIA_DIR=
DINGTALK_APP_CARD_TEMPLATE_ID=
DINGTALK_APP_CARD_CALLBACK_ROUTE_KEY=

# DingTalk group robot webhook
DINGTALK_ROBOT_ENABLED=false
DINGTALK_ROBOT_WEBHOOK_URL=
DINGTALK_ROBOT_SECRET=
